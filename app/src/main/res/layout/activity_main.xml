<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".MainActivity">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- region TOP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:background="@drawable/header_gradient_bg"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileCard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1.5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/baseline_account_circle_24"
                    android:contentDescription="@string/desc_profile" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settingsCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/surface_card_border"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/desc_settings" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notificationCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/surface_card_border"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/settingsCard"
                app:layout_constraintEnd_toStartOf="@id/settingsCard"
                app:layout_constraintTop_toTopOf="@id/settingsCard">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/outline_circle_notifications_24"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/desc_notification" />
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/badge_dot" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- endregion -->

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/bottomNav">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- region BRANDING -->
                <LinearLayout
                    android:id="@+id/brandContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/experience"
                        android:textSize="11sp"
                        android:letterSpacing="0.25"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true" />
                    <TextView
                        android:id="@+id/tvBrandName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:layout_marginBottom="-2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/kwalletpay"
                        android:textColor="#B3818CF8"
                        android:textSize="28sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_fintech"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:alpha="0.8"
                        android:letterSpacing="0.05"
                        android:fontFamily="sans-serif-light" />
                </LinearLayout>
                <!-- endregion -->

                <!-- region QUICK ACTIONS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScanQR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardCheckBalance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/brandContainer"
                    app:layout_constraintHorizontal_weight="1.2">
                    <include layout="@layout/item_primary_action" android:id="@+id/includeScanQR"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bg_balance"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/pro_button_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardShop"
                    app:layout_constraintStart_toEndOf="@+id/cardScanQR"
                    app:layout_constraintTop_toTopOf="@id/cardScanQR"
                    app:layout_constraintHorizontal_weight="1">
                    <include layout="@layout/item_action" android:id="@+id/includeCheckBalance"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/bg_shop"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/pro_button_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardCheckBalance"
                    app:layout_constraintTop_toTopOf="@id/cardScanQR"
                    app:layout_constraintHorizontal_weight="1">
                    <include layout="@layout/item_action" android:id="@+id/includeShop"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDeposit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bg_deposit"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/pro_button_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardPaybill"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardScanQR"
                    app:layout_constraintHorizontal_weight="1">
                    <include layout="@layout/item_action" android:id="@+id/includeDeposit"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPaybill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bg_paybill"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/pro_button_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardTransfer"
                    app:layout_constraintStart_toEndOf="@+id/cardDeposit"
                    app:layout_constraintTop_toTopOf="@id/cardDeposit"
                    app:layout_constraintHorizontal_weight="1">
                    <include layout="@layout/item_action" android:id="@+id/includePaybill"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTransfer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/bg_transfer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/pro_button_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardPaybill"
                    app:layout_constraintTop_toTopOf="@id/cardDeposit"
                    app:layout_constraintHorizontal_weight="1">
                    <include layout="@layout/item_action" android:id="@+id/includeTransfer"/>
                </com.google.android.material.card.MaterialCardView>
                <!-- endregion -->

                <!-- REFER CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/referCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/surface_card_border"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardDeposit">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/refer_card_bg"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">
                        <View android:id="@+id/referGlow" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_blob_1" android:alpha="0" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@+id/referIcon" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="@string/refer_earn_rewards" android:textColor="@color/white" android:textSize="12sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/get_cashback" android:textColor="@color/colorAccent" android:textSize="11sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/referButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginTop="4dp" android:fontFamily="sans-serif-black" android:paddingHorizontal="12dp" android:paddingVertical="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/refer_now" android:textAllCaps="true" android:textColor="@color/white" android:textSize="10sp" app:backgroundTint="@color/colorPrimary" app:cornerRadius="12dp" />
                        </LinearLayout>
                        <ImageView android:id="@+id/referIcon" android:layout_width="40dp" android:layout_height="40dp" android:alpha="0.6" android:rotation="-10" android:src="@drawable/ic_gift_refer" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/white" android:contentDescription="@string/refer_earn_rewards" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FINANCIAL SERVICES SECTION -->
                <TextView 
                    android:id="@+id/tvServicesTitle" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_marginStart="24dp" 
                    android:layout_marginTop="20dp" 
                    android:fontFamily="sans-serif-black" 
                    android:text="@string/financial_services" 
                    android:textColor="@color/text_primary" 
                    android:textSize="14sp" 
                    app:layout_constraintStart_toStartOf="parent" 
                    app:layout_constraintTop_toBottomOf="@id/referCard" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/servicesCard"
                    style="@style/SectionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvServicesTitle">

                    <LinearLayout 
                        android:id="@+id/servicesGrid" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="horizontal" 
                        android:paddingVertical="4dp"
                        android:weightSum="4" 
                        android:baselineAligned="false">
                        
                        <include layout="@layout/item_action" android:id="@+id/includePersonalLoan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <include layout="@layout/item_action" android:id="@+id/includeGoldLoan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <include layout="@layout/item_action" android:id="@+id/includeCreditScore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <include layout="@layout/item_action" android:id="@+id/includeRewards" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TRANSACTIONS -->
                <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/historyHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:paddingHorizontal="24dp" app:layout_constraintTop_toBottomOf="@id/servicesCard">
                    <TextView android:id="@+id/historyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="@string/recent_transactions" android:textColor="@color/text_primary" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                    <TextView android:id="@+id/btnSeeAllHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:fontFamily="sans-serif-medium" android:padding="8dp" android:text="@string/see_all" android:textColor="@color/colorPrimary" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/transactionRecyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" android:paddingHorizontal="20dp" app:layout_constraintTop_toBottomOf="@id/historyHeader" tools:listitem="@layout/item_transaction" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM NAV -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#E6111111"
            app:cardCornerRadius="36dp"
            app:cardElevation="16dp"
            app:strokeColor="@color/surface_card_border"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="3"
                android:baselineAligned="false">

                <!-- Home -->
                <FrameLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <View
                        android:id="@+id/indicatorHome"
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_pill"
                        android:alpha="1" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivNavHome"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/baseline_home_24"
                            app:tint="@color/accent"
                            android:contentDescription="@string/home" />
                        <TextView
                            android:id="@+id/tvNavHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home"
                            android:textColor="@color/accent"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Explore -->
                <FrameLayout
                    android:id="@+id/navExplore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <View
                        android:id="@+id/indicatorExplore"
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_pill"
                        android:alpha="0" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivNavExplore"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/baseline_explore_24"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/explore" />
                        <TextView
                            android:id="@+id/tvNavExplore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/explore"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </FrameLayout>

                <!-- History -->
                <FrameLayout
                    android:id="@+id/navHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <View
                        android:id="@+id/indicatorHistory"
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_pill"
                        android:alpha="0" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivNavHistory"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nav_history"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/history" />
                        <TextView
                            android:id="@+id/tvNavHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/history"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Drawer (Profile Screen Integration) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_main"
        app:elevation="16dp">
        <include layout="@layout/activity_profile" android:id="@+id/drawerProfile" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>